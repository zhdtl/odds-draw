<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🌈 확률 숫자 뽑기</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(
        120deg,
        #ff4d6d,
        #ff9f1c,
        #ffe66d,
        #51cf66,
        #339af0,
        #7950f2,
        #d63384
      );
      background-size: 400% 400%;
      animation: rainbow 10s ease infinite;
    }

    @keyframes rainbow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .app {
      width: min(92%, 520px);
      padding: 30px;
      text-align: center;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
    }

    h1 {
      margin: 0 0 18px;
      color: #7b2cbf;
      font-size: 32px;
    }

    .rainbow-bar {
      height: 12px;
      margin-bottom: 24px;
      border-radius: 20px;
      background: linear-gradient(
        to right,
        red,
        orange,
        yellow,
        green,
        blue,
        indigo,
        violet
      );
    }

    .settings {
      display: grid;
      gap: 12px;
      margin-bottom: 20px;
    }

    label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-weight: bold;
      color: #333;
    }

    input {
      width: 150px;
      padding: 10px;
      border: 2px solid #b197fc;
      border-radius: 12px;
      font-size: 16px;
      text-align: center;
    }

    button {
      width: 100%;
      padding: 15px;
      border: 0;
      border-radius: 16px;
      color: white;
      background: linear-gradient(90deg, #ff006e, #8338ec, #3a86ff);
      font-size: 20px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.88;
      transform: scale(1.02);
    }

    #result {
      min-height: 82px;
      margin-top: 24px;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      color: #555;
    }

    .number {
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      color: white;
      font-size: 23px;
      font-weight: bold;
      background: linear-gradient(135deg, #ff006e, #8338ec, #3a86ff);
      box-shadow: 0 5px 12px rgba(0, 0, 0, 0.2);
      animation: pop 0.35s ease;
    }

    @keyframes pop {
      from {
        opacity: 0;
        transform: scale(0);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .info {
      margin-top: 18px;
      color: #666;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="app">
    <h1>🌈 확률 숫자 뽑기</h1>

    <div class="rainbow-bar"></div>

    <div class="settings">
      <label>
        최소 숫자
        <input id="min" type="number" value="1">
      </label>

      <label>
        최대 숫자
        <input id="max" type="number" value="45">
      </label>

      <label>
        뽑을 개수
        <input id="count" type="number" value="1" min="1">
      </label>
    </div>

    <button onclick="pickNumbers()">🎲 숫자 뽑기</button>

    <div id="result">버튼을 눌러 숫자를 뽑아보세요!</div>

    <div class="info">
      모든 숫자는 동일한 확률로 선택되며 중복은 제외됩니다.
    </div>
  </div>

  <script>
    function pickNumbers() {
      const min = Number(document.getElementById("min").value);
      const max = Number(document.getElementById("max").value);
      const count = Number(document.getElementById("count").value);
      const result = document.getElementById("result");

      if (!Number.isInteger(min) ||
          !Number.isInteger(max) ||
          !Number.isInteger(count) ||
          min > max ||
          count < 1 ||
          count > max - min + 1) {
        result.textContent = "입력값을 올바르게 확인해주세요.";
        return;
      }

      const selected = [];

      while (selected.length < count) {
        const number =
          Math.floor(Math.random() * (max - min + 1)) + min;

        if (!selected.includes(number)) {
          selected.push(number);
        }
      }

      selected.sort((a, b) => a - b);

      result.innerHTML = selected
        .map(number => `<span class="number">${number}</span>`)
        .join("");
    }
  </script>
</body>
</html>
